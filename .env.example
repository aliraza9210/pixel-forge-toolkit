# PixelForge Root Environment Configuration Template
# For server configuration, see server/.env.example

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/pixelforge
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
COOKIE_SECRET=replace_with_another_secure_random_string_min_32_chars
CLIENT_URL=http://localhost:5173
FILE_TTL_MINUTES=60
MAX_FILE_SIZE_MB=35

# Optional AI Providers (Leave empty to use built-in local heuristic engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
