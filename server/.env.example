# ==============================================================================
# PixelForge Server Environment Configuration Template
# Copy this file to .env and provide your deployment-specific settings.
# NEVER commit real production secrets, passwords, or API keys to git.
# ==============================================================================

# Server Network & Runtime
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB 6.0+)
# Example: mongodb://localhost:27017/pixelforge
# Or Mongo Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/pixelforge?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/pixelforge

# Security & Cryptography Keys
# MUST be set to a secure, random string (minimum 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_secure_random_string_min_32_chars

# Allowed CORS Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# File Processing & Storage (Optional, defaults to local folders)
# UPLOADS_DIR=./uploads
# PROCESSED_DIR=./processed
FILE_TTL_MINUTES=60
MAX_FILE_SIZE_MB=35

# AI Provider Credentials (Optional)
# If no provider is configured, PixelForge operates with its built-in Local Intelligence Engine
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
